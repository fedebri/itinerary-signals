# Publish the three-stage recommender; keep research, data and weights local.
/*
!/.gitignore
!/README.md
!/environment.yml
!/Makefile
!/pipeline/
!/tests/
!/docs/

/pipeline/*
!/pipeline/data_features.py
!/pipeline/base_recommender.py
!/pipeline/gru_extension.py

/tests/*
!/tests/test_recommender.py

/docs/*
!/docs/model_results.json

__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
.env
.env.*
