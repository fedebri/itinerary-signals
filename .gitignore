# Portable defaults for local/generated data.
# Reviewed project exceptions below take precedence.
*.csv
*.parquet
*.arrow
*.jsonl

# Publish the three-stage recommender; keep research, data and weights local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/environment.yml
!/Makefile
!/pipeline/
!/tests/

/pipeline/*
!/pipeline/data_features.py
!/pipeline/base_recommender.py
!/pipeline/gru_extension.py

/tests/*
!/tests/test_recommender.py

__pycache__/
*.py[cod]
.pytest_cache/

# Shared credential and OS safety baseline; keep independent of global Git config.
# Existing reviewed template exceptions follow this block.
.env
.env.*
*.env
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
*service-account*.json
id_rsa
id_dsa
id_ecdsa
id_ed25519

# macOS metadata
.DS_Store
.AppleDouble
